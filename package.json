{
  "name": "tex-machina",
  "publisher": "Tony29028",
  "displayName": "TeX-Machina",
  "description": "Interactive LaTeX assistant with symbolic computation, plotting, and bibliography management.",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/tony10486/Tex-Machina"
  },
  "license": "MIT",
  "keywords": [
    "latex",
    "math",
    "sympy",
    "plotting",
    "bibtex",
    "oeis"
  ],
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:latex"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "TeX-Machina",
      "properties": {
        "tex-machina.calc.settings": {
          "type": "object",
          "title": "계산 및 변환 설정",
          "description": "수학 연산(calc) 및 변환(Laplace 등)에 필요한 전역 설정을 관리합니다.",
          "properties": {
            "laplaceSource": {
              "type": "string",
              "default": "t",
              "description": "라플라스 변환의 기본 소스 변수 (예: t)"
            },
            "laplaceTarget": {
              "type": "string",
              "default": "s",
              "description": "라플라스 변환의 결과 대상 변수 (예: s)"
            },
            "angleUnit": {
              "type": "string",
              "enum": [
                "deg",
                "rad"
              ],
              "default": "deg",
              "description": "각도 계산의 기본 단위 (도 또는 라디안)"
            },
            "precision": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50,
              "description": "수치 계산 시 표시할 유효 숫자의 개수"
            },
            "imaginaryUnit": {
              "type": "string",
              "enum": [
                "i",
                "j"
              ],
              "default": "i",
              "description": "허수 단위 기호 (i 또는 j)"
            },
            "simplifyResult": {
              "type": "boolean",
              "default": true,
              "description": "\uacc4\uc0b0 \uacb0\uacfc\ub97c \ud56d\uc0c1 \uc790\ub3d9\uc73c\ub85c \ub2e8\uc21c\ud654(Simplify)\ud560\uc9c0 \uc5ec\ubd80"
            },
            "defaultDomain": {
              "type": "string",
              "enum": [
                "real",
                "complex"
              ],
              "default": "real",
              "description": "\ubcc0\uc218\uc758 \uae30\ubcf8 \ub3c4\uba54\uc778 \uc124\uc815 (\uc2e4\uc218 \ub610\ub294 \ubcf5\uc18c\uc218). \ubcf5\uc18c\uc218 \uc124\uc815 \uc2dc \ub85c\uadf8\ub098 \uac70\ub4ed\uc81c\uacf1 \uacc4\uc0b0 \ubc29\uc2dd\uc774 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
            },
            "rationalNotation": {
              "type": "boolean",
              "default": true,
              "description": "\uacb0\uacfc\ub97c \uac00\ub2a5\ud55c \uacbd\uc6b0 \ubd84\uc218(Rational) \ud615\ud0dc\ub85c \uc720\uc9c0\ud560\uc9c0 \uc5ec\ubd80. \ube44\ud65c\uc131\ud654 \uc2dc \uc18c\uc218\ub85c \ubcc0\ud658\ub429\ub2c8\ub2e4."
            },
            "autoFactor": {
              "type": "boolean",
              "default": false,
              "description": "\uacc4\uc0b0 \ud6c4 \uacb0\uacfc\ub97c \uc790\ub3d9\uc73c\ub85c \uc778\uc218\ubd84\ud574(Factor)\ud558\uc5ec \ud45c\uc2dc\ud560\uc9c0 \uc5ec\ubd80"
            }
          },
          "default": {
            "laplaceSource": "t",
            "laplaceTarget": "s",
            "angleUnit": "deg",
            "precision": 10,
            "imaginaryUnit": "i",
            "simplifyResult": true,
            "defaultDomain": "real",
            "rationalNotation": true,
            "autoFactor": false
          }
        },
        "tex-machina.plot.datDensity": {
          "type": "integer",
          "default": 500,
          "minimum": 10,
          "maximum": 5000,
          "description": "2D PGFPlots .dat \ud30c\uc77c \uc0dd\uc131 \uc2dc \uacc4\uc0b0\ud560 \uc810\uc758 \uac1c\uc218 (\ubc00\ub3c4)"
        },
        "tex-machina.plot.yMultiplier": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "2D \uadf8\ub798\ud504 \ub370\uc774\ud130(.dat) \uc0dd\uc131 \uc2dc y\ucd95 \ud45c\uc2dc \ubc94\uc704\ub97c \ub118\uc5b4\uc11c \uacc4\uc0b0\ud560 \ubc30\uc218 (Clipping Limit)"
        },
        "tex-machina.plot.lineColor": {
          "type": "string",
          "default": "blue",
          "description": "2D PGFPlots \uadf8\ub798\ud504\uc758 \uae30\ubcf8 \uc120 \uc0c9\uc0c1 (\uc608: blue, red, black, cyan!50!blue)"
        },
        "tex-machina.autoBracing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "\uc2a4\ub9c8\ud2b8 \ucca8\uc790 \uc790\ub3d9 \uad04\ud638 (Auto-bracing for Sub/Superscripts) \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. _\ub098 ^ \ub4a4\uc5d0 \ub450 \uae00\uc790 \uc774\uc0c1 \uc785\ub825 \uc2dc \uc790\ub3d9\uc73c\ub85c {}\ub85c \ubb36\uc5b4\uc90d\ub2c8\ub2e4."
        },
        "tex-machina.autoBracing.escapeExponents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-1"
          ],
          "description": "\uc911\uad04\ud638 \uc790\ub3d9 \uc644\uc131 \uc2dc \ucee4\uc11c\ub97c \ubc16\uc73c\ub85c \uc774\ub3d9\uc2dc\ud0ac \uc9c0\uc218(exponent) \ubaa9\ub85d\uc785\ub2c8\ub2e4. (\uc608: ['-1', '2'])"
        },
        "tex-machina.autoLeftRight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 모드 자동 \\left \\right (Auto \\left \\right) 기능을 활성화합니다. ( ) 안에 \\int, \\frac 등 높은 요소가 있으면 자동으로 \\left( ... \\right)로 변환합니다."
        },
        "tex-machina.autoMathWrap.enabled": {
          "type": "boolean",
          "default": true,
          "description": "\uc218\uc2dd \ubaa8\ub4dc \uc790\ub3d9 \uc804\ud658 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \uc77c\ubc18 \ud14d\uc2a4\ud2b8 \ubaa8\ub4dc\uc5d0\uc11c \\alpha\ub098 \\sum \uac19\uc740 \uc218\ud559 \uc804\uc6a9 \ub9e4\ud06c\ub85c\ub97c \ud0c0\uc774\ud551\ud558\uba74 \uc790\ub3d9\uc73c\ub85c $ $\ub97c \uc50c\uc6cc\uc90d\ub2c8\ub2e4."
        },
        "tex-machina.fractionShorthand.enabled": {
          "type": "boolean",
          "default": true,
          "description": "분수 자동 변환 기능을 활성화합니다. '1/2' 또는 '(a+b)/c' 입력 후 스페이스를 누르면 자동으로 \\frac{}{}로 변환됩니다."
        },
        "tex-machina.idxExpansion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "인덱스 자동 확장 기능을 활성화합니다. 수식 내에서 'idx' 입력 시 '{i \\in I}'로, 'GHidx' 입력 시 '[G:H]'로 자동 변환합니다."
        },
        "tex-machina.markdownLatex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "\ub9c8\ud06c\ub2e4\uc6b4 \uc2a4\ud0c0\uc77c \uc790\ub3d9 \ubcc0\ud658 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. **\ud14d\uc2a4\ud2b8** + \uc2a4\ud398\uc774\uc2a4\ub294 \\textbf{\ud14d\uc2a4\ud2b8}\ub85c, - + \uc2a4\ud398\uc774\uc2a4\ub294 itemize \ud658\uacbd\uc73c\ub85c \ubcc0\ud658\ub429\ub2c8\ub2e4."
        },
        "tex-machina.smartQuotes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "LaTeX \uc2a4\ub9c8\ud2b8 \ub530\uc634\ud45c \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \" \ud0a4\ub97c \ub204\ub974\uba74 \uc0c1\ud669\uc5d0 \ub9de\uac8c `` \ub610\ub294 ''\ub85c \ubcc0\ud658\ub429\ub2c8\ub2e4."
        },
        "tex-machina.ellipsis.enabled": {
          "type": "boolean",
          "default": true,
          "description": "... \uc785\ub825 \uc2dc \uc790\ub3d9\uc73c\ub85c LaTeX \ub9d0\uc904\uc784\ud45c \ub9e4\ud06c\ub85c\ub85c \ubcc0\ud658\ud558\ub294 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4."
        },
        "tex-machina.ellipsis.macro": {
          "type": "string",
          "enum": [
            "\\dots",
            "\\cdots"
          ],
          "default": "\\dots",
          "description": "... \uc785\ub825 \uc2dc \ubcc0\ud658\ud560 LaTeX \ub9e4\ud06c\ub85c\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4."
        },
        "tex-machina.mathNav.enabled": {
          "type": "boolean",
          "default": false,
          "description": "\uc218\uc2dd \uacc4\uce35\ubcc4 \uc810\ud504 \ubaa8\ub4dc (Math Navigation Mode) \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \ud65c\uc131\ud654 \uc2dc Alt+\ubc29\ud5a5\ud0a4\ub85c \uc218\uc2dd \ub0b4 \uc8fc\uc694 \uc2ac\ub86f \uc0ac\uc774\ub97c \uc810\ud504\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
        },
        "tex-machina.implicitSubscripts.enabled": {
          "type": "boolean",
          "default": false,
          "description": "\uc554\uc2dc\uc801 \ucca8\uc790 \ubcc0\ud658 (Implicit Subscripts) \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. x1 \uc785\ub825 \uc2dc \uc790\ub3d9\uc73c\ub85c x_1\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4."
        },
        "tex-machina.smartNewline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "스마트 줄바꿈 (Smart Newline) 기능을 활성화합니다. 특정 환경에서 Enter 입력 시 \\\\나 & 등을 자동으로 삽입합니다."
        },
        "tex-machina.autoEndEnv.enabled": {
          "type": "boolean",
          "default": true,
          "description": "자동 환경 닫기 (Auto End Env) 기능을 활성화합니다. \\end 입력 시 가장 가까운 미완성 \\begin 환경을 찾아 자동 완성합니다."
        },
        "tex-machina.mathLigatures.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 전용 리가처 (Mathematical Ligatures) 기능을 활성화합니다. <=, -> 같은 기호 조합을 LaTeX 명령어로 자동 변환합니다."
        },
        "tex-machina.mathLigatures.mappings": {
          "type": "object",
          "default": {
            "->": "\\to ",
            "=>": "\\implies ",
            "<=": "\\le ",
            ">=": "\\ge ",
            "!=": "\\neq ",
            "~=": "\\approx ",
            "~~": "\\approx ",
            "~": "\\sim ",
            "<<": "\\ll ",
            ">>": "\\gg ",
            "==": "\\equiv ",
            ":=": "\\coloneqq ",
            "<-": "\\leftarrow ",
            "<->": "\\leftrightarrow ",
            "<=>": "\\iff ",
            "|->": "\\mapsto ",
            "&&": "\\land ",
            "||": "\\lor ",
            "+-": "\\pm ",
            "<{}|": "\\bra{$1}",
            "|{}>": "\\ket{$1}",
            "<{}|{}>": "\\braket{$1}{$2}"
          },
          "description": "수식 리가처 매핑 사전 (Dictionary). 키=트리거 문자열, 값=LaTeX 치환 결과. {}는 내용을 캡처하는 와일드카드 (예: \"<{}|\" → \"\\bra{$1}\"). {}가 없는 키는 해당 마지막 문자 입력 시 즉시 변환되고, {}가 있는 키는 스페이스바 입력 시 변환됩니다."
        },
        "tex-machina.mathAutoCalc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 자동 계산 (Auto Calc) 기능을 활성화합니다. 수식 내에서 =.. 을 입력하면 SymPy로 계산한 결과로 =..를 자동 치환합니다."
        },
        "tex-machina.mathAutoCalc.defaultOperation": {
          "type": "string",
          "enum": ["auto", "expand", "simplify", "evaluate"],
          "default": "auto",
          "description": "=.. 자동 계산 시 사용할 기본 SymPy 연산입니다. 'auto'는 수식 내용에 따라 자동으로 최적의 연산을 선택합니다."
        },
        "tex-machina.linkedEditing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "환경 이름 동기화 수정 (Linked Editing for Environments) 기능을 활성화합니다. \\begin{env}의 이름을 수정하면 \\end{env}도 자동으로 함께 바꿉니다."
        },
        "tex-machina.mathRefactor.enabled": {
          "type": "boolean",
          "default": false,
          "description": "\uc218\ud559 \ubcc0\uc218 \uc790\ub3d9 \uba40\ud2f0 \ucee4\uc11c \ub9ac\ud329\ud1a0\ub9c1 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. Toggle Mode\uac00 \ud65c\uc131\ud654\ub41c \uc0c1\ud0dc\uc5d0\uc11c \ubcc0\uc218\ub97c \uc120\ud0dd\ud558\uba74 \uc218\uc2dd \ub0b4 \ubaa8\ub4e0 \ub3d9\uc77c \ubcc0\uc218\uac00 \ud568\uaed8 \uc120\ud0dd\ub429\ub2c8\ub2e4."
        },
        "tex-machina.mathNav.selectContent.enabled": {
          "type": "boolean",
          "default": true,
          "description": "\uc218\uc2dd \uc810\ud504 \uc2dc \uc2ac\ub86f(\uad04\ud638) \ub0b4 \ub0b4\uc6a9\uc774 \uc788\ub2e4\uba74 \uc790\ub3d9\uc73c\ub85c \uc120\ud0dd(Selection)\ud569\ub2c8\ub2e4."
        },
        "tex-machina.mathNav.jumpSymbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\\\",
            "&",
            "=",
            "+",
            "-",
            "*",
            "/",
            "<",
            ">",
            ",",
            ";",
            ":"
          ],
          "description": "\uc218\uc2dd \uc810\ud504 \uc2dc \uba48\ucd9c \uae30\ud638(\uc5f0\uc0b0\uc790, \uad6c\ubd84\uc790 \ub4f1)\ub4e4\uc758 \ubaa9\ub85d\uc785\ub2c8\ub2e4."
        },
        "tex-machina.mathNav.selectBrackets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "{}",
            "[]",
            "()"
          ],
          "description": "\uc790\ub3d9 \uc120\ud0dd(Auto-selection)\uc744 \uc801\uc6a9\ud560 \uad04\ud638 \uc30d \ubaa9\ub85d\uc785\ub2c8\ub2e4. (\uc608: '{}')"
        },
        "tex-machina.mathNav.skipCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\frac",
            "\\sqrt",
            "\\int",
            "\\sum",
            "\\prod",
            "\\lim",
            "\\vec",
            "\\bar",
            "\\hat",
            "\\tilde",
            "\\dot",
            "\\ddot",
            "\\sin",
            "\\cos",
            "\\tan",
            "\\log",
            "\\ln"
          ],
          "description": "\uc810\ud504 \uc2dc \uba85\ub839\uc5b4\ub97c \uac74\ub108\ub6f0\uace0 \ubc14\ub85c \ub0b4\ubd80 \uc778\uc790\ub85c \uc774\ub3d9\ud560 LaTeX \uba85\ub839\uc5b4 \ubaa9\ub85d\uc785\ub2c8\ub2e4."
        },
        "tex-machina.mathNav.boundaryBehavior": {
          "type": "string",
          "enum": [
            "before",
            "after",
            "both"
          ],
          "default": "both",
          "description": "\uae30\ud638 \uc8fc\ubcc0\uc5d0\uc11c \uba48\ucd9c \uc704\uce58\ub97c \uc124\uc815\ud569\ub2c8\ub2e4. (before: \uae30\ud638 \uc55e, after: \uae30\ud638 \ub4a4, both: \uc591\ucabd \ubaa8\ub450)"
        },
        "tex-machina.splitMath.atPlus": {
          "type": "boolean",
          "default": false,
          "description": "\uc218\uc2dd \uc790\ub3d9 \ubd84\ud560 \uc2dc \ub4f1\ud638(=) \ubfd0\ub9cc \uc544\ub2c8\ub77c \ub367\uc148/\ube84\uc148(+, -) \uae30\ud638\uc5d0\uc11c\ub3c4 \uc904\ubc14\uafc8\uc744 \ud5c8\uc6a9\ud569\ub2c8\ub2e4."
        },
        "tex-machina.cli.chainDelimiter": {
          "type": "string",
          "enum": [
            "&&",
            "//",
            "|",
            "&"
          ],
          "default": "&&",
          "description": "\uba85\ub839\uc5b4 \uccb4\uc774\ub2dd\uc744 \uc704\ud55c \uad6c\ubd84\uc790\ub97c \uc124\uc815\ud569\ub2c8\ub2e4. (\uae30\ubcf8\uac12: &&)"
        },
        "tex-machina.labelVisualization.settings": {
          "type": "object",
          "title": "\ub77c\ubca8 \uc2dc\uac01\ud654 \uc124\uc815",
          "description": "\ub77c\ubca8 \ub514\ud39c\ub358\uc2dc \uc2dc\uac01\ud654 \uadf8\ub798\ud504\uc758 \ubb3c\ub9ac \uc5d4\uc9c4 \ubc0f \ub178\ub4dc \uc2a4\ud0c0\uc77c\uc744 \uc124\uc815\ud569\ub2c8\ub2e4.",
          "properties": {
            "physicsEnabled": {
              "type": "boolean",
              "default": true,
              "description": "\ubb3c\ub9ac \uc5d4\uc9c4 \uc560\ub2c8\uba54\uc774\uc158 \ud65c\uc131\ud654 \uc5ec\ubd80"
            },
            "solver": {
              "type": "string",
              "enum": [
                "barnesHut",
                "forceAtlas2Based",
                "repulsion",
                "hierarchicalRepulsion"
              ],
              "default": "forceAtlas2Based",
              "description": "\ubb3c\ub9ac \uc5d4\uc9c4 \uc194\ubc84"
            },
            "gravitationalConstant": {
              "type": "number",
              "default": -80,
              "description": "\uc911\ub825 \uc0c1\uc218 (\ucc99\ub825 \uac15\ub3c4)"
            },
            "springLength": {
              "type": "number",
              "default": 80,
              "description": "\ub178\ub4dc \uac04 \uae30\ubcf8 \uac70\ub9ac (\uc2a4\ud504\ub9c1 \uae38\uc774)"
            },
            "springConstant": {
              "type": "number",
              "default": 0.04,
              "description": "\uc2a4\ud504\ub9c1 \uac15\uc131"
            },
            "avoidOverlap": {
              "type": "number",
              "default": 1,
              "minimum": 0,
              "maximum": 1,
              "description": "\ub178\ub4dc \uacb9\uce68 \ubc29\uc9c0 \uac15\ub3c4"
            },
            "stabilizationIterations": {
              "type": "integer",
              "default": 150,
              "description": "\ucd08\uae30 \uc548\uc815\ud654 \ubc18\ubcf5 \ud69f\uc218"
            },
            "baseSize": {
              "type": "number",
              "default": 12,
              "description": "\ub178\ub4dc\uc758 \uae30\ubcf8 \ud06c\uae30"
            },
            "stabilizationFinish": {
              "type": "string",
              "enum": [
                "none",
                "fit",
                "disablePhysics"
              ],
              "default": "none",
              "description": "\uc548\uc815\ud654 \uc885\ub8cc \ud6c4 \ucc98\ub9ac \ubc29\uc2dd"
            }
          },
          "default": {
            "physicsEnabled": true,
            "solver": "forceAtlas2Based",
            "gravitationalConstant": -80,
            "springLength": 80,
            "springConstant": 0.04,
            "avoidOverlap": 1,
            "stabilizationIterations": 150,
            "baseSize": 12,
            "stabilizationFinish": "none"
          }
        },
        "tex-machina.toggle.duration": {
          "type": "integer",
          "default": 10,
