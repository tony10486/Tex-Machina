{
  "name": "tex-machina",
  "publisher": "Tony29028",
  "displayName": "TeX-Machina",
  "description": "Interactive LaTeX assistant with symbolic computation, plotting, and bibliography management.",
  "version": "0.1.11",
  "repository": {
    "type": "git",
    "url": "https://github.com/tony10486/Tex-Machina"
  },
  "license": "MIT",
  "keywords": [
    "latex",
    "math",
    "sympy",
    "plotting",
    "bibtex",
    "oeis"
  ],
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:latex"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "TeX-Machina",
      "properties": {
        "tex-machina.calc.settings": {
          "type": "object",
          "title": "계산 및 변환 설정",
          "description": "수학 연산(calc) 및 변환(Laplace 등)에 필요한 전역 설정을 관리합니다.",
          "properties": {
            "laplaceSource": {
              "type": "string",
              "default": "t",
              "description": "라플라스 변환의 기본 소스 변수 (예: t)"
            },
            "laplaceTarget": {
              "type": "string",
              "default": "s",
              "description": "라플라스 변환의 결과 대상 변수 (예: s)"
            },
            "angleUnit": {
              "type": "string",
              "enum": ["deg", "rad"],
              "default": "deg",
              "description": "각도 계산의 기본 단위 (도 또는 라디안)"
            },
            "precision": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50,
              "description": "수치 계산 시 표시할 유효 숫자의 개수"
            },
            "imaginaryUnit": {
              "type": "string",
              "enum": ["i", "j"],
              "default": "i",
              "description": "허수 단위 기호 (i 또는 j)"
            },
            "simplifyResult": {
              "type": "boolean",
              "default": true,
              "description": "계산 결과를 항상 자동으로 단순화(Simplify)할지 여부"
            },
            "defaultDomain": {
              "type": "string",
              "enum": ["real", "complex"],
              "default": "real",
              "description": "변수의 기본 도메인 설정 (실수 또는 복소수). 복소수 설정 시 로그나 거듭제곱 계산 방식이 달라질 수 있습니다."
            },
            "rationalNotation": {
              "type": "boolean",
              "default": true,
              "description": "결과를 가능한 경우 분수(Rational) 형태로 유지할지 여부. 비활성화 시 소수로 변환됩니다."
            },
            "autoFactor": {
              "type": "boolean",
              "default": false,
              "description": "계산 후 결과를 자동으로 인수분해(Factor)하여 표시할지 여부"
            }
          },
          "default": {
            "laplaceSource": "t",
            "laplaceTarget": "s",
            "angleUnit": "deg",
            "precision": 10,
            "imaginaryUnit": "i",
            "simplifyResult": true,
            "defaultDomain": "real",
            "rationalNotation": true,
            "autoFactor": false
          }
        },
        "tex-machina.plot.datDensity": {
          "type": "integer",
          "default": 500,
          "minimum": 10,
          "maximum": 5000,
          "description": "2D PGFPlots .dat 파일 생성 시 계산할 점의 개수 (밀도)"
        },
        "tex-machina.plot.yMultiplier": {
          "type": "number",
          "default": 5.0,
          "minimum": 1.0,
          "maximum": 50.0,
          "description": "2D 그래프 데이터(.dat) 생성 시 y축 표시 범위를 넘어서 계산할 배수 (Clipping Limit)"
        },
        "tex-machina.plot.lineColor": {
          "type": "string",
          "default": "blue",
          "description": "2D PGFPlots 그래프의 기본 선 색상 (예: blue, red, black, cyan!50!blue)"
        },
        "tex-machina.autoBracing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "스마트 첨자 자동 괄호 (Auto-bracing for Sub/Superscripts) 기능을 활성화합니다. _나 ^ 뒤에 두 글자 이상 입력 시 자동으로 {}로 묶어줍니다."
        },
        "tex-machina.autoBracing.escapeExponents": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["-1"],
          "description": "중괄호 자동 완성 시 커서를 밖으로 이동시킬 지수(exponent) 목록입니다. (예: ['-1', '2'])"
        },
        "tex-machina.autoLeftRight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 모드 자동 \u005cleft \u005cright (Auto \u005cleft \u005cright) 기능을 활성화합니다. ( ) 등 입력 시 내부에 분수나 적분 같은 높은 요소가 있으면 자동으로 \u005cleft, \u005cright를 붙여줍니다."
        },
        "tex-machina.autoMathWrap.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 모드 자동 전환 기능을 활성화합니다. 일반 텍스트 모드에서 \\alpha나 \\sum 같은 수학 전용 매크로를 타이핑하면 자동으로 $ $를 씌워줍니다."
        },
        "tex-machina.fractionShorthand.enabled": {
          "type": "boolean",
          "default": true,
          "description": "분수 자동 변환 기능을 활성화합니다. '1/2' 또는 '(a+b)/c' 입력 후 스페이스를 누르면 자동으로 \\frac{}{}으로 변환됩니다."
        },
        "tex-machina.markdownLatex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "마크다운 스타일 자동 변환 기능을 활성화합니다. **텍스트** + 스페이스는 \\textbf{텍스트}로, - + 스페이스는 itemize 환경으로 변환됩니다."
        },
        "tex-machina.smartQuotes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "LaTeX 스마트 따옴표 기능을 활성화합니다. \" 키를 누르면 상황에 맞게 `` 또는 ''로 변환됩니다."
        },
        "tex-machina.mathNav.enabled": {
          "type": "boolean",
          "default": false,
          "description": "수식 계층별 점프 모드 (Math Navigation Mode) 기능을 활성화합니다. 활성화 시 Alt+방향키로 수식 내 주요 슬롯 사이를 점프할 수 있습니다."
        },
        "tex-machina.mathNav.selectContent.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 점프 시 슬롯(괄호) 내 내용이 있다면 자동으로 선택(Selection)합니다."
        },
        "tex-machina.mathNav.jumpSymbols": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["\\\\", "&", "=", "+", "-", "*", "/", "<", ">", ",", ";", ":"],
          "description": "수식 점프 시 멈출 기호(연산자, 구분자 등)들의 목록입니다."
        },
        "tex-machina.mathNav.selectBrackets": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["{}", "[]", "()"],
          "description": "자동 선택(Auto-selection)을 적용할 괄호 쌍 목록입니다. (예: '{}')"
        },
        "tex-machina.mathNav.skipCommands": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["\\frac", "\\sqrt", "\\int", "\\sum", "\\prod", "\\lim", "\\vec", "\\bar", "\\hat", "\\tilde", "\\dot", "\\ddot", "\\sin", "\\cos", "\\tan", "\\log", "\\ln"],
          "description": "점프 시 명령어를 건너뛰고 바로 내부 인자로 이동할 LaTeX 명령어 목록입니다."
        },
        "tex-machina.mathNav.boundaryBehavior": {
          "type": "string",
          "enum": ["before", "after", "both"],
          "default": "both",
          "description": "기호 주변에서 멈출 위치를 설정합니다. (before: 기호 앞, after: 기호 뒤, both: 양쪽 모두)"
        },
        "tex-machina.splitMath.atPlus": {
          "type": "boolean",
          "default": false,
          "description": "수식 자동 분할 시 등호(=) 뿐만 아니라 덧셈/뺄셈(+, -) 기호에서도 줄바꿈을 허용합니다."
        },
        "tex-machina.cli.chainDelimiter": {
          "type": "string",
          "enum": [
            "&&",
            "//",
            "|",
            "&"
          ],
          "default": "&&",
          "description": "명령어 체이닝을 위한 구분자를 설정합니다. (기본값: &&)"
        },
        "tex-machina.labelVisualization.settings": {
          "type": "object",
          "title": "라벨 시각화 설정",
          "description": "라벨 디펜던시 시각화 그래프의 물리 엔진 및 노드 스타일을 설정합니다.",
          "properties": {
            "physicsEnabled": {
              "type": "boolean",
              "default": true,
              "description": "물리 엔진 애니메이션 활성화 여부"
            },
            "solver": {
              "type": "string",
              "enum": [
                "barnesHut",
                "forceAtlas2Based",
                "repulsion",
                "hierarchicalRepulsion"
              ],
              "default": "forceAtlas2Based",
              "description": "물리 엔진 솔버"
            },
            "gravitationalConstant": {
              "type": "number",
              "default": -80,
              "description": "중력 상수 (척력 강도)"
            },
            "springLength": {
              "type": "number",
              "default": 80,
              "description": "노드 간 기본 거리 (스프링 길이)"
            },
            "springConstant": {
              "type": "number",
              "default": 0.04,
              "description": "스프링 강성"
            },
            "avoidOverlap": {
              "type": "number",
              "default": 1,
              "minimum": 0,
              "maximum": 1,
              "description": "노드 겹침 방지 강도"
            },
            "stabilizationIterations": {
              "type": "integer",
              "default": 150,
              "description": "초기 안정화 반복 횟수"
            },
            "baseSize": {
              "type": "number",
              "default": 12,
              "description": "노드의 기본 크기"
            },
            "stabilizationFinish": {
              "type": "string",
              "enum": [
                "none",
                "fit",
                "disablePhysics"
              ],
              "default": "none",
              "description": "안정화 종료 후 처리 방식"
            }
          },
          "default": {
            "physicsEnabled": true,
            "solver": "forceAtlas2Based",
            "gravitationalConstant": -80,
            "springLength": 80,
            "springConstant": 0.04,
            "avoidOverlap": 1,
            "stabilizationIterations": 150,
            "baseSize": 12,
            "stabilizationFinish": "none"
          }
        },
        "tex-machina.toggle.duration": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 3600,
          "description": "토글 모드가 활성화되어 유지되는 시간(초)입니다."
        },
        "tex-machina.toggle.changeStatusBarColor": {
          "type": "boolean",
          "default": true,
          "description": "토글 모드가 활성화되었을 때 VS Code의 상태 표시줄(Status Bar) 배경색을 초록색으로 변경할지 여부입니다."
        }
      }
    },
    "commands": [
      {
        "command": "tex-machina.toggleSubscriptMode",
        "title": "LaTeX: Toggle Implicit Subscript Mode"
      },
      {
        "command": "tex-machina.addContextShortcut",
        "title": "LaTeX: Add Common Macro Contexts"
      },
      {
        "command": "tex-machina.openCLI",
        "title": "Open TeX-Machina CLI"
      },
      {
        "command": "tex-machina.analyzeWidth",
        "title": "LaTeX: Analyze Formula Width"
      },
      {
        "command": "tex-machina.escapeAutoBracing",
        "title": "LaTeX: Escape Auto-bracing"
      },
      {
        "command": "tex-machina.splitMath",
        "title": "LaTeX: Auto-split Math Formula"
      },
      {
        "command": "tex-machina.formatUnit",
        "title": "LaTeX: Format Unit (siunitx)"
      },
      {
        "command": "tex-machina.insertTable",
        "title": "LaTeX: Insert Table"
      },
      {
        "command": "tex-machina.insertScanPrevention",
        "title": "LaTeX: Insert Scan Prevention Pattern"
      },
      {
        "command": "tex-machina.addHat",
        "title": "LaTeX: Add Hat Diacritic (\\hat{})"
      },
      {
        "command": "tex-machina.addTilde",
        "title": "LaTeX: Add Tilde Diacritic (\\tilde{})"
      },
      {
        "command": "tex-machina.addDot",
        "title": "LaTeX: Add Dot Diacritic (\\dot{})"
      },
      {
        "command": "tex-machina.deleteUnusedLabels",
        "title": "LaTeX: Delete Unused Labels"
      },
      {
        "command": "tex-machina.toggleMathNav",
        "title": "LaTeX: Toggle Formula Node Navigation"
      },
      {
        "command": "tex-machina.mathNavRight",
        "title": "LaTeX: Math Node Navigation Right"
      },
      {
        "command": "tex-machina.mathNavLeft",
        "title": "LaTeX: Math Node Navigation Left"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tex-machina-explorer",
          "title": "TeX-Machina",
          "icon": "$(edit)"
        }
      ]
    },
    "views": {
      "tex-machina-explorer": [
        {
          "type": "webview",
          "id": "tex-machina.preview",
          "name": "Math Preview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tex-machina.toggleSubscriptMode",
        "key": "ctrl+'",
        "mac": "cmd+'",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.openCLI",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;",
        "when": "editorTextFocus"
      },
      {
        "command": "tex-machina.escapeAutoBracing",
        "key": "escape",
        "when": "editorTextFocus && editorLangId == 'latex' && !suggestWidgetVisible && !findWidgetVisible && !parameterHintsVisible && !editorHasSelection && !inSnippetMode"
      },
      {
        "command": "tex-machina.splitMath",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.formatUnit",
        "key": "ctrl+shift+' u",
        "mac": "cmd+shift+' u",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.addHat",
        "key": "alt+shift+6",
        "mac": "alt+shift+6",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.addTilde",
        "key": "alt+shift+`",
        "mac": "alt+shift+`",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.addDot",
        "key": "alt+.",
        "mac": "alt+.",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.toggleMathNav",
        "key": "ctrl+shift+' l",
        "mac": "cmd+shift+' l",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.mathNavRight",
        "key": "alt+right",
        "mac": "alt+right",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.mathNavLeft",
        "key": "alt+left",
        "mac": "alt+left",
        "when": "editorTextFocus && editorLangId == 'latex'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:fast": "vscode-test --run out/test/parser.test.js out/test/mathSplitter.test.js out/test/unitExpander.test.js out/test/macro.test.js out/test/table.test.js out/test/smartSearch.test.js",
    "test:integration": "vscode-test --run out/test/autoBracing.test.js out/test/markdown.test.js out/test/smartQuotes.test.js out/test/diacritics.test.js out/test/labelDetection.test.js out/test/labelDiscovery.test.js out/test/nodeNavigation.test.js out/test/mathAutoWrap.test.js out/test/fractionShorthand.test.js",
    "test:webview": "vscode-test --run out/test/webview.test.js",
    "test:perf": "vscode-test --run out/test/performance.test.js out/test/extreme.test.js",
    "test:only": "vscode-test --run"
  },
  "dependencies": {
    "mathjax-full": "^3.2.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
