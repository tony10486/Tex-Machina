{
  "name": "tex-machina",
  "publisher": "Tony29028",
  "displayName": "TeX-Machina",
  "description": "Interactive LaTeX assistant with symbolic computation, plotting, and bibliography management.",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/tony10486/Tex-Machina"
  },
  "license": "MIT",
  "keywords": [
    "latex",
    "math",
    "sympy",
    "plotting",
    "bibtex",
    "oeis"
  ],
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:latex"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "TeX-Machina",
      "properties": {
        "tex-machina.calc.settings": {
          "type": "object",
          "title": "계산 및 변환 설정",
          "description": "수학 연산(calc) 및 변환(Laplace 등)에 필요한 전역 설정을 관리합니다.",
          "properties": {
            "laplaceSource": {
              "type": "string",
              "default": "t",
              "description": "라플라스 변환의 기본 소스 변수 (예: t)"
            },
            "laplaceTarget": {
              "type": "string",
              "default": "s",
              "description": "라플라스 변환의 결과 대상 변수 (예: s)"
            },
            "angleUnit": {
              "type": "string",
              "enum": [
                "deg",
                "rad"
              ],
              "default": "deg",
              "description": "각도 계산의 기본 단위 (도 또는 라디안)"
            },
            "precision": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50,
              "description": "수치 계산 시 표시할 유효 숫자의 개수"
            },
            "imaginaryUnit": {
              "type": "string",
              "enum": [
                "i",
                "j"
              ],
              "default": "i",
              "description": "허수 단위 기호 (i 또는 j)"
            },
            "simplifyResult": {
              "type": "boolean",
              "default": true,
              "description": "계산 결과를 항상 자동으로 단순화(Simplify)할지 여부"
            },
            "defaultDomain": {
              "type": "string",
              "enum": [
                "real",
                "complex"
              ],
              "default": "real",
              "description": "변수의 기본 도메인 설정 (실수 또는 복소수). 복소수 설정 시 로그나 거듭제곱 계산 방식이 달라질 수 있습니다."
            },
            "rationalNotation": {
              "type": "boolean",
              "default": true,
              "description": "결과를 가능한 경우 분수(Rational) 형태로 유지할지 여부. 비활성화 시 소수로 변환됩니다."
            },
            "autoFactor": {
              "type": "boolean",
              "default": false,
              "description": "계산 후 결과를 자동으로 인수분해(Factor)하여 표시할지 여부"
            }
          },
          "default": {
            "laplaceSource": "t",
            "laplaceTarget": "s",
            "angleUnit": "deg",
            "precision": 10,
            "imaginaryUnit": "i",
            "simplifyResult": true,
            "defaultDomain": "real",
            "rationalNotation": true,
            "autoFactor": false
          }
        },
        "tex-machina.plot.datDensity": {
          "type": "integer",
          "default": 500,
          "minimum": 10,
          "maximum": 5000,
          "description": "2D PGFPlots .dat 파일 생성 시 계산할 점의 개수 (밀도)"
        },
        "tex-machina.plot.yMultiplier": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "2D 그래프 데이터(.dat) 생성 시 y축 표시 범위를 넘어서 계산할 배수 (Clipping Limit)"
        },
        "tex-machina.plot.lineColor": {
          "type": "string",
          "default": "blue",
          "description": "2D PGFPlots 그래프의 기본 선 색상 (예: blue, red, black, cyan!50!blue)"
        },
        "tex-machina.autoBracing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "스마트 첨자 자동 괄호 (Auto-bracing for Sub/Superscripts) 기능을 활성화합니다. _나 ^ 뒤에 두 글자 이상 입력 시 자동으로 {}로 묶어줍니다."
        },
        "tex-machina.autoBracing.escapeExponents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-1"
          ],
          "description": "중괄호 자동 완성 시 커서를 밖으로 이동시킬 지수(exponent) 목록입니다. (예: ['-1', '2'])"
        },
        "tex-machina.autoLeftRight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 모드 자동 \\left \\right (Auto \\left \\right) 기능을 활성화합니다. ( ) 안에 \\int, \\frac 등 높은 요소가 있으면 자동으로 \\left( ... \\right)로 변환합니다."
        },
        "tex-machina.autoMathWrap.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 모드 자동 전환 기능을 활성화합니다. 일반 텍스트 모드에서 \\alpha나 \\sum 같은 수학 전용 매크로를 타이핑하면 자동으로 $ $를 씌워줍니다."
        },
        "tex-machina.fractionShorthand.enabled": {
          "type": "boolean",
          "default": true,
          "description": "분수 자동 변환 기능을 활성화합니다. '1/2' 또는 '(a+b)/c' 입력 후 스페이스를 누르면 자동으로 \\frac{}{}로 변환됩니다."
        },
        "tex-machina.idxExpansion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "인덱스 자동 확장 기능을 활성화합니다. 수식 내에서 'idx' 입력 시 '{i \\in I}'로, 'GHidx' 입력 시 '[G:H]'로 자동 변환합니다."
        },
        "tex-machina.markdownLatex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "마크다운 스타일 자동 변환 기능을 활성화합니다. **텍스트** + 스페이스는 \\textbf{텍스트}로, - + 스페이스는 itemize 환경으로 변환됩니다."
        },
        "tex-machina.smartQuotes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "LaTeX 스마트 따옴표 기능을 활성화합니다. \" 키를 누르면 상황에 맞게 `` 또는 ''로 변환됩니다."
        },
        "tex-machina.ellipsis.enabled": {
          "type": "boolean",
          "default": true,
          "description": "... 입력 시 자동으로 LaTeX 말줄임표 매크로로 변환하는 기능을 활성화합니다."
        },
        "tex-machina.ellipsis.macro": {
          "type": "string",
          "enum": [
            "\\dots",
            "\\cdots"
          ],
          "default": "\\dots",
          "description": "... 입력 시 변환할 LaTeX 매크로를 선택합니다."
        },
        "tex-machina.mathNav.enabled": {
          "type": "boolean",
          "default": false,
          "description": "수식 계층별 점프 모드 (Math Navigation Mode) 기능을 활성화합니다. 활성화 시 Alt+방향키로 수식 내 주요 슬롯 사이를 점프할 수 있습니다."
        },
        "tex-machina.implicitSubscripts.enabled": {
          "type": "boolean",
          "default": false,
          "description": "암시적 첨자 변환 (Implicit Subscripts) 기능을 활성화합니다. x1 입력 시 자동으로 x_1로 변환합니다."
        },
        "tex-machina.smartNewline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "스마트 줄바꿈 (Smart Newline) 기능을 활성화합니다. 특정 환경에서 Enter 입력 시 \\\\나 & 등을 자동으로 삽입합니다."
        },
        "tex-machina.autoEndEnv.enabled": {
          "type": "boolean",
          "default": true,
          "description": "자동 환경 닫기 (Auto End Env) 기능을 활성화합니다. \\end 입력 시 가장 가까운 미완성 \\begin 환경을 찾아 자동 완성합니다."
        },
        "tex-machina.mathLigatures.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 전용 리가처 (Mathematical Ligatures) 기능을 활성화합니다. <=, -> 같은 기호 조합을 LaTeX 명령어로 자동 변환합니다."
        },
        "tex-machina.mathLigatures.mappings": {
          "type": "object",
          "default": {
            "->": "\\to ",
            "=>": "\\implies ",
            "<=": "\\le ",
            ">=": "\\ge ",
            "!=": "\\neq ",
            "~=": "\\approx ",
            "~~": "\\approx ",
            "~": "\\sim ",
            "<<": "\\ll ",
            ">>": "\\gg ",
            "==": "\\equiv ",
            ":=": "\\coloneqq ",
            "<-": "\\leftarrow ",
            "<->": "\\leftrightarrow ",
            "<=>": "\\iff ",
            "|->": "\\mapsto ",
            "&&": "\\land ",
            "||": "\\lor ",
            "+-": "\\pm ",
            "<{}|": "\\bra{$1}",
            "|{}>": "\\ket{$1}",
            "<{}|{}>": "\\braket{$1}{$2}"
          },
          "description": "수식 리가처 매핑 사전 (Dictionary). 키=트리거 문자열, 값=LaTeX 치환 결과. {}는 내용을 캡처하는 와일드카드 (예: \"<{}|\" → \"\\bra{$1}\"). {}가 없는 키는 해당 마지막 문자 입력 시 즉시 변환되고, {}가 있는 키는 스페이스바 입력 시 변환됩니다."
        },
        "tex-machina.mathAutoCalc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 자동 계산 (Auto Calc) 기능을 활성화합니다. 수식 내에서 =.. 을 입력하면 SymPy로 계산한 결과로 =..를 자동 치환합니다."
        },
        "tex-machina.mathAutoCalc.defaultOperation": {
          "type": "string",
          "enum": [
            "auto",
            "expand",
            "simplify",
            "evaluate"
          ],
          "default": "auto",
          "description": "=.. 자동 계산 시 사용할 기본 SymPy 연산입니다. 'auto'는 수식 내용에 따라 자동으로 최적의 연산을 선택합니다."
        },
        "tex-machina.linkedEditing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "환경 이름 동기화 수정 (Linked Editing for Environments) 기능을 활성화합니다. \\begin{env}의 이름을 수정하면 \\end{env}도 자동으로 함께 바꿉니다."
        },
        "tex-machina.mathRefactor.enabled": {
          "type": "boolean",
          "default": false,
          "description": "수학 변수 자동 멀티 커서 리팩토링 기능을 활성화합니다. Toggle Mode가 활성화된 상태에서 변수를 선택하면 수식 내 모든 동일 변수가 함께 선택됩니다."
        },
        "tex-machina.mathNav.selectContent.enabled": {
          "type": "boolean",
          "default": true,
          "description": "수식 점프 시 슬롯(괄호) 내 내용이 있다면 자동으로 선택(Selection)합니다."
        },
        "tex-machina.mathNav.jumpSymbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\\\",
            "&",
            "=",
            "+",
            "-",
            "*",
            "/",
            "<",
            ">",
            ",",
            ";",
            ":"
          ],
          "description": "수식 점프 시 멈출 기호(연산자, 구분자 등)들의 목록입니다."
        },
        "tex-machina.mathNav.selectBrackets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "{}",
            "[]",
            "()"
          ],
          "description": "자동 선택(Auto-selection)을 적용할 괄호 쌍 목록입니다. (예: '{}')"
        },
        "tex-machina.mathNav.skipCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\frac",
            "\\sqrt",
            "\\int",
            "\\sum",
            "\\prod",
            "\\lim",
            "\\vec",
            "\\bar",
            "\\hat",
            "\\tilde",
            "\\dot",
            "\\ddot",
            "\\sin",
            "\\cos",
            "\\tan",
            "\\log",
            "\\ln"
          ],
          "description": "점프 시 명령어를 건너뛰고 바로 내부 인자로 이동할 LaTeX 명령어 목록입니다."
        },
        "tex-machina.mathNav.boundaryBehavior": {
          "type": "string",
          "enum": [
            "before",
            "after",
            "both"
          ],
          "default": "both",
          "description": "기호 주변에서 멈출 위치를 설정합니다. (before: 기호 앞, after: 기호 뒤, both: 양쪽 모두)"
        },
        "tex-machina.splitMath.atPlus": {
          "type": "boolean",
          "default": false,
          "description": "수식 자동 분할 시 등호(=) 뿐만 아니라 덧셈/뺄셈(+, -) 기호에서도 줄바꿈을 허용합니다."
        },
        "tex-machina.cli.chainDelimiter": {
          "type": "string",
          "enum": [
            "&&",
            "//",
            "|",
            "&"
          ],
          "default": "&&",
          "description": "명령어 체이닝을 위한 구분자를 설정합니다. (기본값: &&)"
        },
        "tex-machina.labelVisualization.settings": {
          "type": "object",
          "title": "라벨 시각화 설정",
          "description": "라벨 디펜던시 시각화 그래프의 물리 엔진 및 노드 스타일을 설정합니다.",
          "properties": {
            "physicsEnabled": {
              "type": "boolean",
              "default": true,
              "description": "물리 엔진 애니메이션 활성화 여부"
            },
            "solver": {
              "type": "string",
              "enum": [
                "barnesHut",
                "forceAtlas2Based",
                "repulsion",
                "hierarchicalRepulsion"
              ],
              "default": "forceAtlas2Based",
              "description": "물리 엔진 솔버"
            },
            "gravitationalConstant": {
              "type": "number",
              "default": -80,
              "description": "중력 상수 (척력 강도)"
            },
            "springLength": {
              "type": "number",
              "default": 80,
              "description": "노드 간 기본 거리 (스프링 길이)"
            },
            "springConstant": {
              "type": "number",
              "default": 0.04,
              "description": "스프링 강성"
            },
            "avoidOverlap": {
              "type": "number",
              "default": 1,
              "minimum": 0,
              "maximum": 1,
              "description": "노드 겹침 방지 강도"
            },
            "stabilizationIterations": {
              "type": "integer",
              "default": 150,
              "description": "초기 안정화 반복 횟수"
            },
            "baseSize": {
              "type": "number",
              "default": 12,
              "description": "노드의 기본 크기"
            },
            "stabilizationFinish": {
              "type": "string",
              "enum": [
                "none",
                "fit",
                "disablePhysics"
              ],
              "default": "none",
              "description": "안정화 종료 후 처리 방식"
            }
          },
          "default": {
            "physicsEnabled": true,
            "solver": "forceAtlas2Based",
            "gravitationalConstant": -80,
            "springLength": 80,
            "springConstant": 0.04,
            "avoidOverlap": 1,
            "stabilizationIterations": 150,
            "baseSize": 12,
            "stabilizationFinish": "none"
          }
        },
        "tex-machina.toggle.duration": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 3600,
          "description": "토글 모드가 활성화되어 유지되는 시간(초)입니다."
        },
        "tex-machina.toggle.changeStatusBarColor": {
          "type": "boolean",
          "default": true,
          "description": "토글 모드가 활성화되었을 때 VS Code의 상태 표시줄(Status Bar) 배경색을 초록색으로 변경할지 여부입니다."
        },
        "tex-machina.toggle.profiles": {
          "type": "array",
          "title": "토글 프로필 설정",
          "description": "각 프로필 번호(0-9)별로 활성화할 기능 목록을 설정합니다. (Settings JSON에서 직접 수정하는 것을 권장합니다)",
          "items": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5,
                  6,
                  7,
                  8,
                  9,
                  0
                ],
                "description": "프로필 번호"
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "implicitSubscripts",
                    "autoBracing",
                    "autoLeftRight",
                    "autoMathWrap",
                    "fractionShorthand",
                    "markdownLatex",
                    "smartQuotes",
                    "mathNav",
                    "ellipsis",
                    "smartNewline",
                    "mathLigatures",
                    "linkedEditing",
                    "mathRefactor",
                    "extendedInput",
                    "mathAutoCalc"
                  ],
                  "enumDescriptions": [
                    "암시적 첨자 (x1 -> x_1)",
                    "스마트 첨자 자동 괄호",
                    "자동 \\left \\right",
                    "수식 모드 자동 전환",
                    "분수 자동 변환",
                    "마크다운 스타일 변환",
                    "스마트 따옴표",
                    "수식 계층 점프",
                    "말줄임표 (... -> \\dots/\\cdots)",
                    "스마트 줄바꿈",
                    "수식 전용 리가처",
                    "환경 이름 동기화",
                    "수학 변수 리팩토링 (멀티 커서)",
                    "확장 문자 입력 모드 (그리스 문자, 기호)",
                    "수식 자동 계산 (=.. -> = result)",
                    "수식 고스트 텍스트 (= -> Tab으로 결과 삽입)"
                  ]
                },
                "description": "해당 프로필에서 활성화할 기능 목록"
              }
            },
            "required": [
              "profile",
              "features"
            ]
          },
          "default": [
            {
              "profile": 1,
              "features": [
                "implicitSubscripts"
              ]
            }
          ]
        },
        "tex-machina.argumentNavigation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tab/Shift+Tab 명령어 인자 간 전환 기능을 활성화합니다. 커서가 LaTeX 명령어의 괄호 인자 내부에 있을 때 Tab을 누르면 다음 명령어의 동일 괄호 타입 인자로 이동합니다."
        },
        "tex-machina.mathToggle.sequence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "$",
            "\\[",
            "equation"
          ],
          "description": "수식 모드 전환(Math Mode Toggle) 시 순환할 환경의 순서를 설정합니다. (예: '$', '\\[', 'equation', 'align', 'gather', 'equation*' 등)"
        },
        "tex-machina.pasteExternalData.enabled": {
          "type": "boolean",
          "default": true,
          "description": "외부 데이터(Excel/CSV) 붙여넣기 자동 변환 기능을 활성화합니다."
        },
        "tex-machina.pasteExternalData.autoPrompt": {
          "type": "boolean",
          "default": true,
          "description": "탭/쉼표 구분 데이터를 감지하면 자동으로 변환 여부를 묻습니다."
        },
        "tex-machina.pasteExternalData.defaultMode": {
          "type": "string",
          "enum": [
            "auto",
            "matrix",
            "tabular"
          ],
          "default": "auto",
          "description": "붙여넣기 시 기본 모드. 'auto'는 커서 위치의 수식 환경을 감지합니다."
        },
        "tex-machina.pasteExternalData.alwaysAskMode": {
          "type": "boolean",
          "default": false,
          "description": "항상 Matrix/Tabular 선택 QuickPick을 표시합니다."
        },
        "tex-machina.pasteExternalData.matrixType": {
          "type": "string",
          "enum": [
            "pmatrix",
            "bmatrix",
            "vmatrix",
            "Vmatrix",
            "Bmatrix",
            "matrix"
          ],
          "default": "bmatrix",
          "description": "Matrix 모드에서 사용할 기본 행렬 환경."
        },
        "tex-machina.pasteExternalData.tabularStyle": {
          "type": "string",
          "enum": [
            "array",
            "booktabs"
          ],
          "default": "array",
          "description": "Tabular 모드에서 사용할 기본 스타일."
        },
        "tex-machina.pasteExternalData.alignmentMode": {
          "type": "string",
          "enum": [
            "auto",
            "allCenter",
            "allLeft",
            "allRight"
          ],
          "default": "auto",
          "description": "열 정렬 방식. 'auto'는 데이터 타입에 따라 자동 감지합니다."
        },
        "tex-machina.pasteExternalData.hasBorders": {
          "type": "boolean",
          "default": true,
          "description": "Array 스타일 Tabular에서 테두리(|, \\hline)를 추가합니다."
        },
        "tex-machina.pasteExternalData.hasHeader": {
          "type": "string",
          "enum": [
            "auto",
            "true",
            "false"
          ],
          "default": "auto",
          "description": "첫 행을 헤더로 간주할지 여부. 'auto'는 첫 행이 텍스트일 때 자동 감지."
        },
        "tex-machina.pasteExternalData.escapeMode": {
          "type": "string",
          "enum": [
            "smart",
            "all",
            "none"
          ],
          "default": "smart",
          "description": "특수 문자 이스케이프 방식. 'smart'는 LaTeX 명령어(\\...)는 보존합니다."
        },
        "tex-machina.pasteExternalData.showPreview": {
          "type": "boolean",
          "default": true,
          "description": "변환 전 변환될 코드의 미리보기를 QuickPick에 표시합니다."
        },
        "tex-machina.pasteExternalData.removeEmptyRows": {
          "type": "boolean",
          "default": true,
          "description": "데이터의 완전히 빈 행(Empty Row)을 제거합니다."
        },
        "tex-machina.pasteExternalData.recognizeCSV": {
          "type": "boolean",
          "default": true,
          "description": "쉼표(Comma)로 구분된 CSV 데이터를 자동으로 인식합니다."
        },
        "tex-machina.pasteExternalData.recognizeTSV": {
          "type": "boolean",
          "default": true,
          "description": "탭(Tab)으로 구분된 TSV 데이터를 자동으로 인식합니다."
        },
        "tex-machina.pasteExternalData.recognizeHTMLTable": {
          "type": "boolean",
          "default": true,
          "description": "text/html 클립보드의 HTML <table> 데이터를 자동으로 인식합니다."
        },
        "tex-machina.pasteExternalData.recognizeSemicolon": {
          "type": "boolean",
          "default": true,
          "description": "세미콜론(Semicolon)으로 구분된 데이터를 자동으로 인식합니다."
        },
        "tex-machina.pasteExternalData.recognizeSpace": {
          "type": "boolean",
          "default": false,
          "description": "연속 공백(Multi-space)으로 구분된 고정폭 데이터를 자동으로 인식합니다."
        },
        "tex-machina.pasteExternalData.customDelimiters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "사용자 정의 구분자 목록입니다. 정규식(예: \\|)도 사용 가능합니다. 클립보드 데이터에 포함된 경우 자동 인식 후보에 포함됩니다."
        },
        "tex-machina.extendedInput.enabled": {
          "type": "boolean",
          "default": false,
          "description": "확장 문자 입력 모드 (Extended Input Mode) 기능 활성화. 활성화 시 항상 동작하며, 비활성화 시 단축키(cmd+e)로만 토글 가능합니다."
        },
        "tex-machina.extendedInput.singleShot": {
          "type": "boolean",
          "default": true,
          "description": "단일 문자 입력 후 자동 종료. true면 cmd+e 후 한 문자만 변환하고 모드가 자동 해제됩니다. false면 토글 모드(10초간 유지)로 동작합니다."
        },
        "tex-machina.shorthandMode.singleShot": {
          "type": "boolean",
          "default": true,
          "description": "한 번 확장 후 자동 종료. true면 alt+g 후 Space로 한 번 확장하고 모드가 자동 해제됩니다. false면 연속 모드(10초간 유지)로 동작합니다."
        },
        "tex-machina.shorthandMode.mappings": {
          "type": "object",
          "default": {},
          "description": "사용자 정의 단축어 매핑. 기본 매핑(bc→\\bigcup 등)을 확장 또는 덮어씁니다. 예: { \"bc\": \"\\\\bigcup\", \"bi\": \"\\\\bigcap\" }"
        },
        "tex-machina.structureWrap.titleBehavior": {
          "type": "string",
          "enum": [
            "none",
            "cursor"
          ],
          "default": "none",
          "description": "Title argument behavior for environment wrapping. 'none': no title argument. 'cursor': add empty title brackets and place cursor inside."
        },
        "tex-machina.structureWrap.environments": {
          "type": "object",
          "default": {},
          "description": "Custom environment mappings for wrap feature. Key is the short identifier, value has 'name' (LaTeX env name) and 'hasTitle' (boolean). Merged with built-in environments (thm, lemma, proof, defn, cor, prop, box, remark, example)."
        },
        "tex-machina.snippets.enabled": {
          "type": "boolean",
          "default": true,
          "description": "사용자 정의 스니펫 시스템 활성화 여부"
        },
        "tex-machina.snippets.triggerChar": {
          "type": "string",
          "default": ";",
          "description": "스니펫 타이핑 트리거 문자 (예: ';' → ';frac' 입력 시 분수 스니펫 확장)"
        },
        "tex-machina.snippets.autoInsertEnv": {
          "type": "boolean",
          "default": false,
          "description": "\\begin{env} 입력 완료 시 해당 환경용 스니펫 본문을 자동 삽입합니다"
        }
      }
    },
