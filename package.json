        "command": "tex-machina.navigateArgumentBackward",
        "key": "shift+tab",
        "mac": "shift+tab",
        "when": "editorTextFocus && editorLangId == 'latex' && !suggestWidgetVisible && !inSnippetMode"
      },
      {
        "command": "tex-machina.pasteExternalData.smart",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.pasteExternalData.matrix",
        "key": "ctrl+alt+shift+v",
        "mac": "cmd+alt+shift+v",
        "when": "editorTextFocus && editorLangId == 'latex'"
      },
      {
        "command": "tex-machina.pasteExternalData.tabular",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && editorLangId == 'latex'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "xvfb-run -a vscode-test",
    "test:fast": "vscode-test --run out/test/parser.test.js out/test/mathSplitter.test.js out/test/unitExpander.test.js out/test/macro.test.js",
    "test:integration": "vscode-test --run out/test/autoBracing.test.js out/test/markdown.test.js out/test/smartQuotes.test.js out/test/diacritics.test.js out/test/labelDetection.test.js out/test/labelDiscovery.test.js out/test/nodeNavigation.test.js out/test/mathAutoWrap.test.js out/test/fractionShorthand.test.js",
    "test:webview": "vscode-test --run out/test/webview.test.js",
    "test:perf": "vscode-test --run out/test/performance.test.js out/test/extreme.test.js",
    "test:calc": "vscode-test --run out/test/calc_engine_high_difficulty.test.js out/test/calc_engine_extreme.test.js",
    "test:only": "vscode-test --run"
  },
